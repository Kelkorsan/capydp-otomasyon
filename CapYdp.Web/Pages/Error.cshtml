@page
@model ErrorModel
@{
    ViewData["Title"] = "Sistem Hatası";
}

<div class="card border-danger shadow-sm mt-4">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">İşlem Sırasında Bir Hata Oluştu</h5>
    </div>
    <div class="card-body">
        <p class="mb-2">İsteğiniz işlenirken beklenmeyen bir durumla karşılaşıldı. Lütfen ana sayfaya dönerek işlemi tekrar deneyiniz.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-3">
                <strong>İstek Kimliği (Request ID):</strong> <code>@Model.RequestId</code>
            </p>
        }
        <a asp-page="/Index" class="btn btn-outline-dark btn-sm">Ana Sayfaya Dön</a>
    </div>
</div>
