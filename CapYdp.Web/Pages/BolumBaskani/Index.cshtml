@page
@model CapYdp.Web.Pages.BolumBaskani.IndexModel
@{
    ViewData["Title"] = "Bölüm Başkanı Paneli (Salt Okuma)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Bölüm Başkanı İzleme Paneli <span class="badge bg-secondary fs-6">Salt Okuma</span></h3>
        <span class="text-muted small">Tüm ÇAP/YDP öğrenci kayıtları ve denetim izi salt okuma modunda görüntülenir.</span>
    </div>
    <a asp-page="/BolumBaskani/IslemKayitlari" class="btn btn-outline-dark btn-sm">Denetim İzini Görüntüle</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Öğrenci No</th>
                    <th>Ad Soyad</th>
                    <th>Program</th>
                    <th>Anadal Bölümü</th>
                    <th>Kabul Dönemi</th>
                    <th>Anadal GANO</th>
                    <th>Durum</th>
                    <th class="text-end pe-3">Detay</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Ogrenciler)
                {
                    <tr>
                        <td class="ps-3"><code>@o.OgrenciNo</code></td>
                        <td class="fw-semibold">@o.Kullanici.AdSoyad</td>
                        <td><span class="badge bg-dark">@o.ProgramTuru</span></td>
                        <td class="small">@o.AnadalBolum</td>
                        <td class="small">@o.KabulDonemi.DonemAdi</td>
                        <td>@(o.AnadalGano?.ToString("0.00") ?? "-")</td>
                        <td><span class="badge bg-secondary">@o.Durum</span></td>
                        <td class="text-end pe-3">
                            <a asp-page="/BolumBaskani/OgrenciDetay" asp-route-id="@o.Id" class="btn btn-outline-primary btn-sm">
                                Kartı İncele &rarr;
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
